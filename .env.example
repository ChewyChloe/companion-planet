# Optional; blank uses local mock dialogue. Never prefix keys with VITE_.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# PORT=8080  # optional production override; leave unset for npm run dev
# Optional GLB, normalized to feet at origin and ~0.9 units high:
# VITE_CHARACTER_MODEL_URL=/models/nebula.glb
# Public website only: exact origins, comma separated (leave blank for local Wi-Fi).
# WEB_ORIGINS=https://your-domain.example
